{
  "expo": {
    "name": "Starfall",
    "slug": "starfall",
    "version": "1.0.0",
    "scheme": "starfall",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05060f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paolomissagia.starfall"
    },
    "android": {
      "package": "com.paolomissagia.starfall",
      "adaptiveIcon": {
        "backgroundColor": "#0d0f2b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Starfall",
      "shortName": "Starfall",
      "themeColor": "#05060f",
      "backgroundColor": "#05060f"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#05060f"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "A falling-words typing game for studying flashcards. Import Anki, CSV or TSV decks and type the answers before they hit the ground.",
    "extra": {
      "eas": {
        "projectId": "75c1cebc-d1a5-4f2c-a510-4b89dff015e7"
      }
    },
    "owner": "paolomissagia"
  }
}
