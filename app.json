{
  "expo": {
    "name": "Starfall",
    "slug": "starfall",
    "version": "1.0.0",
    "scheme": "starfall",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05060f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paolomissagia.starfall"
    },
    "android": {
      "package": "com.paolomissagia.starfall",
      "adaptiveIcon": {
        "backgroundColor": "#0d0f2b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Starfall",
      "shortName": "Starfall",
      "themeColor": "#05060f",
      "backgroundColor": "#05060f"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#05060f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
